<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/theme">
        <file alias="theme-light.qss">resources/theme/theme-light.qss</file>
    </qresource>
    <qresource prefix="/i18n">
        <file alias="app_zh_TW.qm">resources/i18n/app_zh_TW.qm</file>
        <file alias="app_en.qm">resources/i18n/app_en.qm</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="logo.png">resources/icons/logo.png</file>
        <file alias="logo-1024px.png">resources/icons/logo-1024px.png</file>
        <file alias="logo-1024px-transparent.png">resources/icons/logo-1024px-transparent.png</file>
        <file alias="chevron-down.png">resources/icons/chevron-down.png</file>
        <file alias="chevron-up.png">resources/icons/chevron-up.png</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="AlibabaPuHuiTi-3-55-Regular.ttf">resources/fonts/AlibabaPuHuiTi-3-55-Regular.ttf</file>
    </qresource>
    <qresource prefix="/logos/camera">
        <file alias="Canon_1440_301.png">resources/logos/camera/Canon_1440_301.png</file>
        <file alias="Nikon-700-700.png">resources/logos/camera/Nikon-700-700.png</file>
        <file alias="Olympus-Logo-1440-331.png">resources/logos/camera/Olympus-Logo-1440-331.png</file>
        <file alias="Pentax_Logo-662-133.png">resources/logos/camera/Pentax_Logo-662-133.png</file>
        <file alias="Phase_One_logo-1280-177.png">resources/logos/camera/Phase_One_logo-1280-177.png</file>
        <file alias="dji-logo-700-413.png">resources/logos/camera/dji-logo-700-413.png</file>
        <file alias="fujifilm-logo-1100-183.png">resources/logos/camera/fujifilm-logo-1100-183.png</file>
        <file alias="gopro-logo-1600-492.png">resources/logos/camera/gopro-logo-1600-492.png</file>
        <file alias="hasselblad-logo-1400-146.png">resources/logos/camera/hasselblad-logo-1400-146.png</file>
        <file alias="hasselblad-logo-2500-260.png">resources/logos/camera/hasselblad-logo-2500-260.png</file>
        <file alias="leica-logo-700-700.png">resources/logos/camera/leica-logo-700-700.png</file>
        <file alias="others.png">resources/logos/camera/others.png</file>
        <file alias="panasonic-logo-1440-228.png">resources/logos/camera/panasonic-logo-1440-228.png</file>
        <file alias="panasonic-logo2-1603-245.png">resources/logos/camera/panasonic-logo2-1603-245.png</file>
        <file alias="ricoh-logo-1440-260.png">resources/logos/camera/ricoh-logo-1440-260.png</file>
        <file alias="sigma-logo-2500-532.png">resources/logos/camera/sigma-logo-2500-532.png</file>
        <file alias="sony-logo-1100-194.png">resources/logos/camera/sony-logo-1100-194.png</file>
    </qresource>
</RCC>
