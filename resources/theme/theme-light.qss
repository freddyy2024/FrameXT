/* ============================================================
   FrameXT 浅色主题（Token 对齐 04-UI设计.md §1，全局圆角 5px）
   色板：
     窗口底    #F5F6F8   卡片   #FFFFFF   边框   #E4E7EC
     分隔线    #E9EBEF   弱边   #D8DCE2
     文字主    #1F2329   次级   #5A6068   弱化   #9AA0A8
     强调      #6C5CE7   悬停   #5B4BD5   浅底   #EFEBFD
     危险      #E5484D   成功   #2FA36B   警示   #E8A13C
     Logo 渐变 #7C6AF0 → #5B8DEF（135°）
   ============================================================ */

/* ---------- 全局 ---------- */
QMainWindow, #centralArea {
    background: #F5F6F8;
}

/* 窗口最外侧 1px 浅灰边框（frameless 窗口的视觉边界） */
#centralArea {
    border: 1px solid #D8DCE2;
}

QWidget {
    color: #1F2329;
    font-size: 12px;
    /* 全局品牌字体：思源黑体 SC Regular（随资源嵌入，
       main.cpp 加载，M5.5 起）；缺字回退微软雅黑 */
    font-family: "Source Han Sans SC", "Microsoft YaHei UI";
}

QLabel {
    background: transparent;
}

QToolTip {
    background: #FFFFFF;
    color: #1F2329;
    border: 1px solid #D8DCE2;
    border-radius: 5px;
    padding: 4px 8px;
}

/* ---------- 标题栏 ---------- */
/* #titleBar 底色与下缘分隔线由 TitleBar::paintEvent 自绘 */

QToolButton#languageButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    color: #5A6068;
    padding: 4px 8px;
}

QToolButton#languageButton:hover {
    background: #EFEBFD;
    color: #6C5CE7;
}

QToolButton#languageButton::menu-indicator {
    image: none;   /* 文案已带 ▾，隐藏默认指示箭头 */
}

QToolButton#captionMin, QToolButton#captionMax, QToolButton#captionEye,
QToolButton#captionAbout {
    background: transparent;
    border: none;
    color: #5A6068;
    /* 图标字形必须覆盖全局字体规则（QSS 字体优先于代码 setFont） */
    font-family: "Segoe Fluent Icons";
    font-size: 10px;
}

QToolButton#captionMin:hover, QToolButton#captionMax:hover,
QToolButton#captionAbout:hover {
    background: #EEF0F3;
    color: #1F2329;
}

QToolButton#captionMin:pressed, QToolButton#captionMax:pressed,
QToolButton#captionAbout:pressed {
    background: #E4E7EC;
}

QToolButton#captionClose {
    background: transparent;
    border: none;
    color: #5A6068;
    font-family: "Segoe Fluent Icons";
    font-size: 10px;
}

QToolButton#captionClose:hover {
    background: #E5484D;   /* 关闭悬停红 */
    color: #FFFFFF;
}

QToolButton#captionClose:pressed {
    background: #D63B40;
    color: #FFFFFF;
}

/* ---------- 图标按钮（工具条/面板标题共用 #toolGlyph） ---------- */
/* 用户指令：hover 不出现边框，以颜色变化 + 手型光标（代码设置）反馈 */
QToolButton#toolGlyph {
    background: transparent;
    border: none;
    border-radius: 5px;
    color: #5A6068;
    padding: 2px 5px;
    /* Segoe 图标字形（覆盖全局字体；1:1 文字按钮同 objectName，
       Segoe Fluent Icons 含数字/冒号字形，此前显示正常） */
    font-family: "Segoe Fluent Icons";
}

QToolButton#toolGlyph:hover {
    background: transparent;
    border: none;
    color: #6C5CE7;
}

QToolButton#toolGlyph:pressed {
    color: #5B4BD5;
}

QToolButton#toolGlyph:disabled {
    color: #C3C8CF;
}

/* ---------- 面板卡片 ---------- */
#card {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 5px;
}

/* 卡片内滚动区透明（QScrollArea 及其内容 widget 默认灰底/窗口底，
   会盖住 #card 白底——用户报障：基础属性面板与导入导出卡颜色不一致） */
QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
}

#panelHeader, #cardBody {
    background: transparent;
}

#panelHeader {
    border-bottom: 1px solid #F3F4F7;
}

#panelTitle {
    font-weight: 600;
}

#panelCount {
    color: #9AA0A8;
}

#sidePanel, #centerPanel, #bottomPanel {
    background: transparent;
}

/* 预览画布：与其他面板卡片一致的实线边框；背景实际由自绘 paintEvent
   fillRect 承担（QSS background 对自绘 widget 不生效），值仅作同步备注 */
#previewCanvas {
    background: #DDE0E5;
    border: 1px solid #E4E7EC;
    border-radius: 5px;
}

#emptyHint {
    color: #9AA0A8;
}

#emptyHintPrimary {
    color: #5A6068;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D8DCE2;
    border-radius: 5px;
    padding: 0 14px;
    min-height: 26px;
    color: #1F2329;
}

QPushButton:hover {
    border-color: #6C5CE7;
    color: #6C5CE7;
}

QPushButton:pressed {
    background: #F3F4F7;
}

QPushButton:disabled {
    background: #F3F4F7;
    border-color: #E9EBEF;
    color: #9AA0A8;
}

QPushButton#primaryButton {
    background: #6C5CE7;
    border: none;
    color: #FFFFFF;
}

QPushButton#primaryButton:hover {
    background: #5B4BD5;
}

QPushButton#primaryButton:pressed {
    background: #4F3FC4;
}

QPushButton#primaryButton:disabled {
    background: #C3C8CF;
    color: #FFFFFF;
}

/* ---------- 输入控件 ---------- */
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #FFFFFF;
    border: 1px solid #D8DCE2;
    border-radius: 5px;
    min-height: 26px;
    padding: 0 8px;
}

QComboBox:hover, QLineEdit:hover {
    border-color: #B9ACF5;
}

QComboBox:focus, QLineEdit:focus {
    border-color: #6C5CE7;
}

QComboBox:disabled, QLineEdit:disabled {
    background: #F3F4F7;
    color: #9AA0A8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* 箭头用 PNG 资源（border 三角技巧在 Qt 渲染为实心方块，用户报障）。
   注意不可加 hover/focus 变色规则：Qt QSS 对「逗号多选择器+伪元素」
   解析有缺陷（:hover::down-arrow 规则被无条件匹配），hover 图会被
   多画一遍在控件中部形成双箭头（离屏探针实证）；hover 反馈由
   combo 边框变色承担 */
QComboBox::down-arrow {
    image: url(:/icons/chevron-down.png);
    width: 10px;
    height: 6px;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 5px;
    selection-background-color: #EFEBFD;
    selection-color: #1F2329;
    outline: none;
}

/* SpinBox 上下按钮：原生箭头偏宽（用户反馈样式丑陋），统一 PNG 箭头
   并收窄按钮命中区 */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    width: 16px;
    background: transparent;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #F3F4F7;
    border-radius: 3px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/chevron-up.png);
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/chevron-down.png);
    width: 8px;
    height: 5px;
}

/* ---------- 菜单 ---------- */
QMenu {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 5px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #EFEBFD;
    color: #1F2329;
}

QMenu::separator {
    height: 1px;
    background: #E9EBEF;
    margin: 4px 8px;
}

/* ---------- 列表 ---------- */
QListWidget {
    background: #FFFFFF;
    border: none;
    outline: none;
}

QListWidget::item {
    min-height: 32px;
    border-radius: 5px;
    margin: 1px 4px;
}

QListWidget::item:hover {
    background: #F3F4F7;
}

/* 照片缩略图条：margin 归零（项间分隔由 QListView spacing 提供，
   delegate 按完整 item rect 居中绘制图像，margin 会造成背景与图像错位） */
#photoThumbList::item {
    margin: 0px;
}

QListWidget::item:selected {
    background: #EFEBFD;
    color: #1F2329;
}

/* ---------- 滑杆（模板参数，M3 使用） ---------- */
QSlider::groove:horizontal {
    height: 4px;
    background: #E9EBEF;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #6C5CE7;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #FFFFFF;
    border: 2px solid #6C5CE7;
}

QSlider::handle:horizontal:hover {
    border-color: #5B4BD5;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C3C8CF;
    border-radius: 3px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #9AA0A8;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #C3C8CF;
    border-radius: 3px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background: #9AA0A8;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 分隔/分割条 ---------- */
QSplitter::handle {
    background: #F5F6F8;
}

/* ---------- 画布交互层（3.4/3.5 第二批） ---------- */

/* 批量操作结果提示（toast，3s 自动消失） */
#toast {
    background: rgba(31, 35, 41, 0.92);
    color: #FFFFFF;
    font-size: 12px;
    padding: 8px 16px;
    border-radius: 16px;
}

/* 水印内容行（§3.5 开关行） */
#watermarkRow {
    border-radius: 4px;
}
#watermarkRow:hover {
    background: #F5F6F8;
}
#watermarkRow QLineEdit {
    background: #FFFFFF;
    border: 1px solid #D8DCE2;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 12px;
}
#watermarkRow QLineEdit:focus {
    border-color: #6C5CE7;
}

/* 选中元素样式区：浅灰细边框（用户指令，取色板弱边 #D8DCE2），
   本体透明融入白卡；外部两侧缩进 5px；标题浮于 margin 区并遮断边框线 */
#styleGroup {
    border: 1px solid #D8DCE2;
    border-radius: 5px;
    margin-top: 8px;
    margin-left: 5px;
    margin-right: 5px;
    background: transparent;
}
#styleGroup::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #5A6068;
    font-size: 12px;
    /* 遮边框线的底色 = 所在白卡的底色（本体已透明） */
    background: #FFFFFF;
}
#watermarkRow[rowSelected="true"] {
    background: #EFEBFD;
    border-left: 2px solid #6C5CE7;
}

/* 表单小节标签（导出面板「标签在上」排版，用户指令重排） */
#sectionLabel {
    color: #9AA0A8;
    font-size: 11px;
}

/* 元素样式区：文字颜色块（原 QPushButton 默认样式渲染成突兀黑方块） */
QPushButton#colorButton {
    background: #FFFFFF;
    border: 1px solid #D8DCE2;
    border-radius: 4px;
    padding: 1px;
}

QPushButton#colorButton:hover {
    border-color: #6C5CE7;
}

/* 元素样式区：B/I 迷你开关按钮 */
QToolButton#styleMiniButton {
    background: transparent;
    border: 1px solid #D8DCE2;
    border-radius: 4px;
    color: #5A6068;
    min-width: 26px;
    min-height: 24px;
    padding: 0;
}

QToolButton#styleMiniButton:hover {
    border-color: #6C5CE7;
    color: #6C5CE7;
}

QToolButton#styleMiniButton:checked {
    background: #EFEBFD;
    border-color: #6C5CE7;
    color: #6C5CE7;
}
