{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
    "configurePresets": [
        {
            "name": "win-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg-installed"
            }
        },
        {
            "name": "win-debug",
            "inherits": "win-base",
            "displayName": "Windows Debug（Qt 6 msvc2022 + Ninja）",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "win-release",
            "inherits": "win-base",
            "displayName": "Windows Release（Qt 6 msvc2022 + Ninja）",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "win-debug", "configurePreset": "win-debug" },
        { "name": "win-release", "configurePreset": "win-release" }
    ],
    "testPresets": [
        {
            "name": "win-debug",
            "configurePreset": "win-debug",
            "environment": {
                "PATH": "$env{QT_ROOT_DIR}/bin;$penv{PATH}"
            },
            "output": { "outputOnFailure": true }
        },
        {
            "name": "win-release",
            "configurePreset": "win-release",
            "environment": {
                "PATH": "$env{QT_ROOT_DIR}/bin;$penv{PATH}"
            },
            "output": { "outputOnFailure": true }
        }
    ]
}
