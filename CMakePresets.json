{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
    "configurePresets": [
        {
            "name": "win-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "environment": {
                "VCPKG_ROOT": "D:/MyApp/vcpkg-2024.11.16"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "D:/MyApp/Qt/6.11.1/msvc2022_64",
                "CMAKE_MAKE_PROGRAM": "D:/MyApp/Qt/Tools/Ninja/ninja.exe",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            }
        },
        {
            "name": "win-debug",
            "inherits": "win-base",
            "displayName": "Windows Debug（Qt 6.11 msvc2022 + Ninja）",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "win-release",
            "inherits": "win-base",
            "displayName": "Windows Release（Qt 6.11 msvc2022 + Ninja）",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "win-debug", "configurePreset": "win-debug" },
        { "name": "win-release", "configurePreset": "win-release" }
    ],
    "testPresets": [
        {
            "name": "win-debug",
            "configurePreset": "win-debug",
            "environment": {
                "PATH": "D:/MyApp/Qt/6.11.1/msvc2022_64/bin;$penv{PATH}"
            },
            "output": { "outputOnFailure": true }
        },
        {
            "name": "win-release",
            "configurePreset": "win-release",
            "environment": {
                "PATH": "D:/MyApp/Qt/6.11.1/msvc2022_64/bin;$penv{PATH}"
            },
            "output": { "outputOnFailure": true }
        }
    ]
}
